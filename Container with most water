class Solution:
    def maxArea(self, height):
        left = 0
        right = len(height) - 1
        answer = 0
        while left < right:
            h = min(height[left], height[right])
            width = right - left
            water = h * width
            if water > answer:
                answer = water
            if height[left] < height[right]:
                left += 1
            else:
                right -= 1
        return answer
